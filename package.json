{
  "name": "leetcode_among_us",
  "version": "2.0.0",
  "description": "LeetCode tracking platform for MCA students at NIT Warangal",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "tsx watch server.ts",
    "dev": "concurrently \"pnpm run start:dev\" \"cd client && pnpm start\"",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "cd client && pnpm build",
    "build": "pnpm install && pnpm build:server && pnpm build:client",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^25.6.0",
    "concurrently": "^10.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "shell-quote": ">=1.8.4",
      "react-router": ">=7.15.0",
      "qs": ">=6.15.2",
      "ip-address": ">=10.1.1",
      "esbuild": ">=0.28.1"
    }
  }
}
